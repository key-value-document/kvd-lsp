{
    "activationEvents": [
        "onLanguage:kvd"
    ],
    "bugs": {
        "url": "https://github.com/key-value-document/kvd-lsp/issues"
    },
    "categories": [
        "Programming Languages"
    ],
    "contributes": {
        "commands": [
            {
                "command": "kvd.restartServer",
                "title": "KVD: Restart Language Server"
            }
        ],
        "configuration": {
            "properties": {
                "kvd.serverPath": {
                    "default": "",
                    "description": "Absolute path to the kvd-lsp binary. Overrides the OS-specific setting and auto-detection.",
                    "type": "string"
                },
                "kvd.serverPathDarwin": {
                    "default": "~/.cargo/bin/kvd-lsp",
                    "description": "Absolute path to the kvd-lsp binary on macOS. `~` and environment variables are expanded.",
                    "type": "string"
                },
                "kvd.serverPathLinux": {
                    "default": "~/.cargo/bin/kvd-lsp",
                    "description": "Absolute path to the kvd-lsp binary on Linux. `~` and environment variables are expanded.",
                    "type": "string"
                },
                "kvd.serverPathWindows": {
                    "default": "~/.cargo/bin/kvd-lsp.exe",
                    "description": "Absolute path to the kvd-lsp binary on Windows. `~` and environment variables are expanded.",
                    "type": "string"
                }
            },
            "title": "KVD",
            "type": "object"
        },
        "grammars": [
            {
                "language": "kvd",
                "path": "./syntaxes/kvd.tmGrammar.json",
                "scopeName": "source.kvd"
            }
        ],
        "languages": [
            {
                "aliases": [
                    "KVD"
                ],
                "extensions": [
                    ".kvd"
                ],
                "id": "kvd"
            }
        ]
    },
    "dependencies": {
        "vscode-languageclient": "^9.0.1"
    },
    "description": "KVD language support (diagnostics, completion, hover, formatting, go to definition) via kvd-lsp",
    "devDependencies": {
        "@types/mocha": "^10.0.10",
        "@types/node": "^20.0.0",
        "@types/vscode": "^1.82.0",
        "@vscode/test-cli": "^0.0.15",
        "@vscode/test-electron": "^3.1.0",
        "@vscode/vsce": "^3.0.0",
        "typescript": "^5.0.0"
    },
    "displayName": "KVD",
    "engines": {
        "vscode": "^1.82.0"
    },
    "homepage": "https://github.com/key-value-document/kvd-lsp#readme",
    "keywords": [
        "kvd",
        "config",
        "data-format",
        "language-server",
        "lsp"
    ],
    "license": "MIT",
    "main": "./out/extension.js",
    "name": "kvd-vscode",
    "publisher": "KeyValueDocument",
    "repository": {
        "directory": "editors/vscode",
        "type": "git",
        "url": "https://github.com/key-value-document/kvd-lsp.git"
    },
    "scripts": {
        "compile": "tsc -p ./",
        "package": "vsce package",
        "pretest": "npm run compile && cargo build --manifest-path ../../Cargo.toml",
        "publish": "vsce publish",
        "test": "vscode-test",
        "vscode:prepublish": "npm run compile",
        "watch": "tsc -watch -p ./"
    },
    "version": "0.4.0"
}
